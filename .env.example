# ---------------------------------------------------------------------------
# Sanity blog (Milestone M2)
# ---------------------------------------------------------------------------
# The site builds and deploys WITHOUT any of these set — the blog simply shows
# an "Articles coming soon" empty state until a dedicated Sanity project exists.
# Set these once `npx sanity init` has created the new project.

# Public project id + dataset. Safe to expose to the browser (read-only CDN).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# SERVER-ONLY write token used by /api/like-post and /api/view-post to increment
# counters. NEVER prefix this with NEXT_PUBLIC_ and never expose it to the
# client. Set it in the Netlify environment (and a local .env.local for testing).
# Create it in Sanity: Manage > API > Tokens, with Editor (write) permission.
SANITY_API_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Contact form SMTP (Milestone M1 — already in use)
# ---------------------------------------------------------------------------
EMAIL_USER=
EMAIL_PASSWORD=
